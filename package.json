{
  "name": "omg-docs",
  "version": "0.1.0",
  "private": true,
  "description": "User, administrator and operator documentation for Open Model Gateway, the self-hosted, single-enterprise AI model gateway.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/check-names.mjs",
    "check:links": "node scripts/check-links.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "start": "serve out",
    "screenshots": "node scripts/import-screenshots.mjs",
    "screenshots:check": "node scripts/import-screenshots.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "fumadocs-core": "16.15.17",
    "fumadocs-mdx": "15.4.5",
    "fumadocs-ui": "16.15.17",
    "lucide-react": "1.48.0",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.28",
    "serve": "14.2.6",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
